[Unit]
Description=RecruitIQ API (FastAPI on 127.0.0.1:8020)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=recruitiq
Group=recruitiq
WorkingDirectory=/opt/recruitiq/app
EnvironmentFile=/etc/recruitiq/env
ExecStart=/opt/recruitiq/app/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8020 --workers 1
Restart=on-failure
RestartSec=3

# Shared host with a latency-sensitive trading system: RecruitIQ is the thing
# that dies under memory pressure, never the neighbor. MemoryHigh throttles
# before MemoryMax kills.
MemoryHigh=768M
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
