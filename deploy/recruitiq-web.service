[Unit]
Description=RecruitIQ web (Next.js standalone on 127.0.0.1:3001)
After=network-online.target recruitiq-api.service
Wants=network-online.target

[Service]
Type=exec
User=recruitiq
Group=recruitiq
WorkingDirectory=/opt/recruitiq/app/web
Environment=NODE_ENV=production
Environment=API_BASE_URL=http://127.0.0.1:8020
# Optional, secret-free settings the web process needs, e.g.
# DEPLOYMENT_MODE=internal on a company install (must match the API's value
# in /etc/recruitiq/env). Absent on the public demo.
EnvironmentFile=-/etc/recruitiq/web.env
ExecStart=/usr/bin/node scripts/start-standalone.mjs 3001
Restart=on-failure
RestartSec=3

MemoryHigh=384M
MemoryMax=512M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
