# RecruitIQ environment configuration.
# Copy to .env and fill in. Never commit .env.
#
# Only POSTGRES_* is strictly required to boot the backend. MinIO and
# Redis are optional - the app degrades gracefully without them.

# ==== Core ====
ENVIRONMENT=development
API_URL=http://localhost:8000
BASE_URL=http://localhost:8000
API_VERSION=v1
ENABLE_SWAGGER=true
LOG_LEVEL=INFO
LOG_FILE=logs/recruitiq.log

# ==== PostgreSQL (required) ====
# 5433 = the docker-compose pgvector Postgres (docker compose up -d db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ats_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_CONN=postgresql://your_db_user:your_db_password@localhost:5433/ats_db

# ==== Embeddings - served by an existing Ollama instance (see README) ====
OLLAMA_BASE_URL=https://ollama.sentienttrader.ai
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT=20.0

# ==== Redis (optional) ====
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_DECODE_RESPONSES=true

# ==== MinIO (optional; falls back to local disk) ====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes
MINIO_USE_SSL=false

# ==== LLM provider chain (Phase 2): ollama -> openrouter -> anthropic ====
# Tier 1 - local Ollama (best-effort, hard 20s cap, never retried).
# Reuses OLLAMA_BASE_URL above.
OLLAMA_CHAT_ENABLED=true
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_CHAT_TIMEOUT=20.0

# Tier 2 - OpenRouter (the real cloud fallback).
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_ENABLED=true
OPENROUTER_TIMEOUT=60

# Tier 3 - Claude (benchmark reference + final fallback; costs cents).
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_ENABLED=true

# Chain order; drop a name to disable that tier for this deployment.
LLM_PROVIDER_ORDER=ollama,openrouter,anthropic

# Per-task override (ADR 0002). Resume parsing is schema-critical + low-volume,
# so it goes to the eval winner first (evals/results.md) instead of local-first.
# An entry may pin a model with `provider:model`, same syntax as run_eval.py.
LLM_PROVIDER_ORDER_RESUME_PARSING=openrouter:google/gemini-2.5-flash-lite,anthropic,ollama

# Groq - used for reranking.
GROQ_API_KEY=gsk_your-key-here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=true
GROQ_TIMEOUT=30

# Optional - Google Custom Search (web_search_service).
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ==== Portkey gateway (optional) ====
PORTKEY_ENABLED=false
PORTKEY_GATEWAY_URL=
PORTKEY_CACHE_STRATEGY=simple
PORTKEY_CACHE_TTL=3600
PORTKEY_RETRY_ATTEMPTS=3
PORTKEY_TIMEOUT=30

# ==== Models and embeddings ====
# Embeddings come from Ollama nomic-embed-text (768-dim) - see OLLAMA_* above
VECTOR_DIMENSION=768
SPACY_MODEL=en_core_web_lg
LLM_MODEL_PATH=
FALLBACK_MODEL=
DOCUMENT_GENERATION_MODEL=
PARAMETER_EXTRACTION_MODEL=
SECTION_DETECTION_MODEL=
SEARCH_INDEX_PATH=
MAX_TOKENS=4096

# ==== Resume parsing ====
PARSER_TIMEOUT=120
PARSER_MAX_RETRIES=3
PARSER_BATCH_SIZE=10
PARSER_CACHE_ENABLED=true
PARSER_MIN_CONFIDENCE=0.5
PARSER_FALLBACK_CHAIN=llm,regex
CONFIDENCE_THRESHOLD=0.7
NER_CONFIDENCE_THRESHOLD=0.7
OCR_LANGUAGE=en
ENABLE_GPU=false
ENABLE_ADVANCED_NER=true
ENABLE_CONTACT_EXTRACTION=true
ENABLE_FUZZY_MATCHING=true
ENABLE_LAYOUT_ANALYSIS=true
ENABLE_SECTION_DETECTION=true
