        # Use the re module imported at the top level
        
        # Get local model service
        local_model_service = get_local_model_service()
        
        # Check if local model is available with short timeout
        model_available = run_async(local_model_service.is_available, timeout=5)
        
        if model_available and model_available is not None:
            logger.info("Extracting education with local model...")
            
            # Prepare a focused prompt for education extraction with specific instructions
            education_prompt = f"""You are a resume parsing assistant that extracts structured education data from resumes.

Extract ALL educational qualifications from this resume text.

For each education entry, extract the following information into JSON format:
- degree: The degree name or certification (e.g., 'Bachelor of Science', 'MBA')
- institution: The name of the school, university or institution
