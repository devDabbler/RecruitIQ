"""
Patch to integrate local model parsing into the resume parser.
This replaces LLM-based extraction with local Ollama model for better performance and no API costs.
"""
import logging
import json
import re
import asyncio
from typing import Dict, List, Any, Optional
from collections import Counter

from backend.utils.resume_parser import ResumeParser
from backend.services.local_model_service import get_local_model_service

logger = logging.getLogger(__name__)

# Original extraction methods to be patched
original_extract_experience_llm = ResumeParser._extract_experience_llm
original_extract_education_llm = ResumeParser._extract_education_llm
original_extract_skills = ResumeParser._extract_skills
original_extract_personal_info = ResumeParser._extract_personal_info

# Helper for running async functions synchronously with timeout
def run_async(async_func, *args, timeout=30, **kwargs):
    try:
        # Check if there's already an event loop in this thread
        try:
            loop = asyncio.get_event_loop()
        except RuntimeError:
            # If there's no event loop, create a new one
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
        
        # Add timeout to prevent hanging
        task = asyncio.ensure_future(async_func(*args, **kwargs))
        return loop.run_until_complete(asyncio.wait_for(task, timeout=timeout))
    except asyncio.TimeoutError:
        logger.error(f"Operation timed out after {timeout} seconds: {async_func.__name__}")
        return None
    except Exception as e:
        logger.error(f"Error in run_async for {async_func.__name__}: {str(e)}")
        return None

# Local model helper functions
async def extract_with_local_model(model_service, prompt, model_name='resume-parser-code'):
    """Extract structured data from text using local Ollama model."""
    # Define regex patterns for fallback extraction if needed
    job_pattern = r'(?:job|title|position)[\s:]+(.*?)(?:\n|\.|,|$)'
    company_pattern = r'(?:company|employer|organization)[\s:]+(.*?)(?:\n|\.|,|$)'
    date_pattern = r'(?:date|duration|period)[\s:]+(.*?)(?:\n|\.|,|$)'
    location_pattern = r'(?:location|place|city|state)[\s:]+(.*?)(?:\n|\.|,|$)'
    
    # Add explicit instructions to format response as JSON
    enhanced_prompt = f"""{prompt}
    
IMPORTANT: Format your response ONLY as a valid JSON object or array. Do not include any explanatory text, markdown formatting, or code blocks.
For example, if asked to extract names, your response should be: ["John Smith", "Jane Doe"]
NOT: ```json["John Smith", "Jane Doe"]```
NOT: The names are: ["John Smith", "Jane Doe"]
JUST: ["John Smith", "Jane Doe"]"""

    # Try the local model with timeout protection
    try:
        logger.info(f"Calling Ollama API with model {model_name} and 15-second timeout")
        
        # Get response from Ollama with timeout
        try:
            response_task = model_service._generate_response(
                model_name,
                enhanced_prompt,
                temperature=0.1,
                max_tokens=2000  # Reduced token count for faster response
            )
            response_text = await asyncio.wait_for(response_task, timeout=15.0)
            logger.info("Successfully received response from Ollama API")
        except asyncio.TimeoutError:
            logger.error("Ollama API call timed out after 15 seconds")
            return [{"title": "Resume Parsing Timeout", "company": "Unknown", "date_range": "", "description": "Local model timed out while parsing resume."}]
        
        # Process the response with timeout protection
        try:
            logger.info("Processing JSON response with timeout")
            
            # Simple extraction function with timeout
            async def extract_json():
                # Try to find a JSON array
                start_idx = response_text.find('[')
                end_idx = response_text.rfind(']')
                
                if start_idx >= 0 and end_idx > start_idx:
                    try:
                        json_str = response_text[start_idx:end_idx+1]
                        logger.info(f"Found JSON array: {json_str[:50]}...")
                        return json.loads(json_str)
                    except json.JSONDecodeError:
                        pass
                
                # Try to find a JSON object
                start_idx = response_text.find('{')
                end_idx = response_text.rfind('}')
                
                if start_idx >= 0 and end_idx > start_idx:
                    try:
                        json_str = response_text[start_idx:end_idx+1]
                        logger.info(f"Found JSON object: {json_str[:50]}...")
                        obj = json.loads(json_str)
                        return [obj] if isinstance(obj, dict) else obj
                    except json.JSONDecodeError:
                        pass
                
                # If no valid JSON found, create a fallback response
                logger.warning("No valid JSON found in response")
                return [{"title": "Parsing Error", "company": "Unknown", "date_range": "", "description": "Failed to parse valid JSON from response"}]
            
            # Run JSON extraction with timeout
            result = await asyncio.wait_for(extract_json(), timeout=3.0)
            logger.info(f"Successfully extracted {len(result)} items from response")
            return result
            
        except asyncio.TimeoutError:
            logger.error("JSON processing timed out")
            return [{"title": "JSON Processing Timeout", "company": "Unknown", "date_range": "", "description": "Timed out while processing JSON"}]
        except Exception as e:
            logger.error(f"Error processing response: {str(e)}")
            return [{"title": "Processing Error", "company": "Unknown", "date_range": "", "description": f"Error: {str(e)}"}]
    
    except Exception as e:
        logger.error(f"Unexpected error in local model extraction: {str(e)}")
        
        # Last resort fallback - return minimal valid structure
        return [{"title": "Error", "company": "Unknown", "date_range": "", "description": f"Failed to extract data: {str(e)}"}]
# Enhanced experience extraction for local model
def _extract_experience_llm_local(self) -> List[Dict[str, Any]]:
    """Extract experience information using local Ollama model with fallback to original method."""
    try:
        # Get local model service
        local_model_service = get_local_model_service()
        
        # Check if local model is available with short timeout
        model_available = run_async(local_model_service.is_available, timeout=5)
        
        if model_available and model_available is not None:
            logger.info("Extracting experience with local model...")
            
            # Prepare a focused prompt for experience extraction with specific instructions
            experience_prompt = f"""You are a resume parsing assistant that extracts structured experience data from resumes.

Extract ALL work experience entries from this resume text.

For each position, extract the following information into JSON format:
- title: The job title or position name
- company: The company name
- date_range: The full date range of employment (e.g., 'Jan 2020 - Mar 2022')
- start_date: Start date in YYYY-MM format when possible
- end_date: End date in YYYY-MM format, or 'Present' for current positions
- location: The job location (city, state, country)
- description: The COMPLETE job description including all responsibilities and achievements

Format the output ONLY as a clean JSON array of objects with the fields above.

RESUME TEXT:
{self.text}
"""
            
            # Run the async extraction synchronously with a shorter timeout
            logger.info("Calling local model with 10 second timeout")
            result = run_async(
                extract_with_local_model,
                local_model_service,
                experience_prompt,
                timeout=10,  # Shorter 10 second timeout to prevent hanging
                model_name='resume-parser-code'
            )
            
            # Check if the result is valid
            if result and isinstance(result, list) and len(result) > 0:
                logger.info(f"Local model extracted {len(result)} experience entries")
                return result
            else:
                logger.warning("Local model returned empty or invalid experience results, falling back to original method")
        else:
            logger.warning("Local model not available for experience extraction, using original method")
    except Exception as e:
        logger.error(f"Error in local model experience extraction: {str(e)}")
    
    # Fall back to original method
    logger.info("Falling back to original experience extraction method")
    return original_extract_experience_llm(self)
                
