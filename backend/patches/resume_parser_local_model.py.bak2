# Enhanced skills extraction for local model
def _extract_skills_local(self) -> List[str]:
    """Extract skills using local model with standard extraction fallback."""
    try:
        # Get local model service
        local_model_service = get_local_model_service()

        # Check if local model is available with short timeout
        model_available = run_async(local_model_service.is_available, timeout=5)

        if model_available and model_available is not None:
            logger.info("Extracting skills with local model...")

            # Prepare a focused prompt for skills extraction with specific instructions
            skills_prompt = f"""You are a resume parsing assistant that extracts skills from resumes.

Analyze this resume text and extract ALL technical and professional skills mentioned.

Format your response as a simple JSON array of skill strings.
Example: ["Python", "Project Management", "JavaScript"]

RESUME TEXT:
{self.text}
"""

            # Run the async extraction synchronously with a shorter timeout
            logger.info("Calling local model with 10 second timeout for skills")
            skills_result = run_async(
                extract_with_local_model,
                local_model_service,
                skills_prompt,
                timeout=10,  # 10 second timeout
                model_name='resume-parser-code'
            )

            # Process the skills result
            if skills_result and isinstance(skills_result, list):
                # The model might return skills as objects or strings
                if all(isinstance(item, str) for item in skills_result):
                    skills = [skill.lower() for skill in skills_result]
                    logger.info(f"Local model extracted {len(skills)} skills as strings")
                    return skills
                elif all(isinstance(item, dict) for item in skills_result):
                    # Try to extract skills from objects
                    skills = []
                    for item in skills_result:
                        if isinstance(item, dict) and 'skill' in item:
                            skills.append(item['skill'].lower())
                        elif isinstance(item, dict) and 'name' in item:
                            skills.append(item['name'].lower())
                    logger.info(f"Local model extracted {len(skills)} skills from objects")
                    return skills

            logger.warning("Local model returned invalid skills format, falling back to original method")
        else:
            logger.warning("Local model not available for skills extraction, using original method")

    except Exception as e:
        logger.error(f"Error in local model skills extraction: {str(e)}")

    # Fall back to original method
    logger.info("Falling back to original skills extraction method")
    return original_extract_skills(self)

# Enhanced personal info extraction for local model
def _extract_personal_info_local(self) -> Dict[str, Optional[str]]:
    """Enhanced personal information extraction using both local model and spaCy.
    This method combines the power of the local LLM with spaCy's NER to improve extraction accuracy.
    """
    # Start with the original personal info extraction
    personal_info = original_extract_personal_info(self)
    
    # If we already have a name, just return the original result
    if personal_info.get('name') and personal_info.get('name') != 'Unknown':
        logger.info(f"Already found name via standard extraction: {personal_info.get('name')}")
        return personal_info
    
    try:
        # Get local model service
        local_model_service = get_local_model_service()
        
        # Check if local model is available with short timeout
        model_available = run_async(local_model_service.is_available, timeout=5)
        
        if model_available and model_available is not None:
            logger.info("Attempting to extract personal info with local model...")
            
            # Focused prompt for personal information extraction
            personal_info_prompt = f"""You are a resume parser that extracts personal information from resumes.

Extract ONLY the following personal information from this resume text:
- name: The candidate's full name (first and last name)
- email: Email address if present
- phone: Phone number if present
- location: Location/address if present

Format the output ONLY as a clean JSON object with the fields above. 
OMIT any fields where you couldn't find information.

RESUME TEXT:
{self.text[:2000]}  # Focus on the first 2000 chars where personal info is typically found
"""
            
            # Run async extraction synchronously with timeout
            result = run_async(
                extract_with_local_model,
                local_model_service,
                personal_info_prompt,
                timeout=15,  # 15 second timeout to prevent hanging
                model_name='resume-parser-code'
            )
            
            if result and isinstance(result, dict):
                # Process name if found
                if 'name' in result and result['name'] and result['name'] != 'Unknown':
                    candidate_name = result['name'].strip()
                    
                    # Validate it looks like a proper name
                    name_words = candidate_name.split()
                    if len(name_words) >= 2 and all(word[0].isupper() for word in name_words if len(word) > 1):
                        personal_info['name'] = candidate_name
                        logger.info(f"Found name using local model: {candidate_name}")
                
                # Process other fields if found
                for field in ['email', 'phone', 'location']:
                    if field in result and result[field] and (field not in personal_info or not personal_info[field]):
                        personal_info[field] = result[field]
                        logger.info(f"Found {field} using local model: {result[field]}")
            
            # If name is still unknown but we have a spaCy doc, try one more approach with named entity frequency
            if personal_info.get('name') == 'Unknown' and self.doc:
                # Use a heuristic based on the frequency and position of person entities
                person_entities = [ent.text.strip() for ent in self.doc.ents if ent.label_ == "PERSON"]
                
                if person_entities:
                    # Count occurrences of each person entity
                    from collections import Counter
                    person_counts = Counter(person_entities)
                    
                    # Filter to entities with at least 2 words (likely full names)
                    full_names = [name for name in person_counts.keys() if len(name.split()) >= 2]
                    
                    if full_names:
                        # Get the most frequent full name
                        most_common_name = max([(name, person_counts[name]) for name in full_names], key=lambda x: x[1])[0]
                        personal_info['name'] = most_common_name
                        logger.info(f"Found name using frequency analysis: {most_common_name}")
        else:
            logger.info("Local model not available for personal info extraction")
            
    except Exception as e:
        logger.error(f"Error in enhanced personal info extraction: {str(e)}")
        # Just continue with the original results if there's an error
    
    return personal_info

# Patched methods
def _extract_experience_llm_local(self) -> List[Dict[str, Any]]:
    """Extract experience information using local Ollama model with fallback to original method."""
    try:
        # Use the re module imported at the top level
        
        # Get local model service
        local_model_service = get_local_model_service()
        
        # Check if local model is available with short timeout
        model_available = run_async(local_model_service.is_available, timeout=5)
        
        if model_available and model_available is not None:
            logger.info("Extracting experience with local model...")
            
            # Prepare a focused prompt for experience extraction with specific instructions
            experience_prompt = f"""You are a resume parsing assistant that extracts structured experience data from resumes.

Extract ALL work experience entries from this resume text.

For each position, extract the following information into JSON format:
- title: The job title or position name
- company: The company name
- date_range: The full date range of employment (e.g., 'Jan 2020 - Mar 2022')
- start_date: Start date in YYYY-MM format when possible
- end_date: End date in YYYY-MM format, or 'Present' for current positions
- location: The job location (city, state, country)
- description: The COMPLETE job description including all responsibilities and achievements

Format the output ONLY as a clean JSON array of objects with the fields above.

RESUME TEXT:
{self.text}
"""
            
            # Run the async extraction synchronously with a shorter timeout
            logger.info("Calling local model with 10 second timeout")
            result = run_async(
                extract_with_local_model,
                local_model_service,
                experience_prompt,
                timeout=10,  # Shorter 10 second timeout to prevent hanging
                model_name='resume-parser-code'
            )
            
            if result and isinstance(result, list) and len(result) > 0:
                # Normalize and accept any entries with at least one non-empty value
                valid_items = []
                for item in result:
                    if not isinstance(item, dict):
                        logger.warning(f"Skipping non-dictionary item from local model: {item}")
                        continue
                    # Normalize field names
                    normalized = {}
                    field_map = {
                        'organization': 'company',
                        'employer': 'company',
                        'position': 'title',
                        'role': 'title',
                        'field_of_work': 'description',
                        'field_of_study': 'description',
                        'summary': 'description',
                    }
                    for k, v in item.items():
                        key = field_map.get(k, k)
                        normalized[key] = v
                    # Accept if any field has a non-empty value
                    if any(str(v).strip() for v in normalized.values()):
                        clean_item = {}
                        for field in ['title', 'company', 'date_range', 'start_date', 'end_date', 'location', 'description']:
                            clean_item[field] = normalized.get(field, "")
                        valid_items.append(clean_item)
                if valid_items:
                    logger.info(f"Successfully validated {len(valid_items)} experience entries with local model (relaxed)")
                    return valid_items
                else:
                    logger.warning("No valid experience entries found after normalization")
            logger.warning("Local model extraction returned invalid or incomplete experience data")
        else:
            logger.info("Local model not available for experience extraction")
        
        # Fall back to the original implementation
        logger.info("Falling back to original experience extraction method")
        return original_extract_experience_llm(self)
    except Exception as e:
        logger.error(f"Error in patched _extract_experience_llm: {str(e)}")
        # Fall back to the original method
        return original_extract_experience_llm(self)

