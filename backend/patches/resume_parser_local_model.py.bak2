    except Exception as e:
        logger.error(f"Error in patched _extract_education_llm: {str(e)}")
        # Fall back to the original method
        return original_extract_education_llm(self)

def _extract_skills_local(self) -> List[str]:
    """Extract skills using local model with standard extraction fallback."""
    try:
        # Use the re module imported at the top level
        
        # Get local model service
        local_model_service = get_local_model_service()
        
        # Check if local model is available with short timeout
        model_available = run_async(local_model_service.is_available, timeout=5)
        
        if model_available and model_available is not None:
            logger.info("Extracting skills with local model...")
            
            # Prepare a focused prompt for skills extraction with specific instructions
            skills_prompt = f"""You are a resume parsing assistant that extracts skills from resumes.

Extract ALL technical and professional skills from this resume text. Include:
- Programming languages (e.g., Python, Java)
- Frameworks and libraries (e.g., React, TensorFlow)
- Tools and software (e.g., PostgreSQL, Docker)
- Methodologies (e.g., Agile, DevOps)
- Soft skills (e.g., Leadership, Communication)

Format your response ONLY as a clean JSON array of skill strings (all lowercase), with no explanations or additional text.
Example: ["python", "javascript", "communication", "leadership"]

RESUME TEXT:
{self.text}
"""
            
            # Run the async extraction synchronously
            result = run_async(
                extract_with_local_model,
                local_model_service,
                skills_prompt,
                timeout=15,  # 15 second timeout to prevent hanging
                model_name='resume-parser-code'
            )
            
            if result and isinstance(result, list):
                # Normalize skills (lowercase, remove duplicates, remove empty strings)
                normalized_skills = []
                
                for item in result:
                    # Handle both string skills and potential dictionary items
                    if isinstance(item, str) and item.strip():
                        # Convert to lowercase and remove any surrounding quotes
                        clean_skill = item.lower().strip().strip('"\'')
                        if clean_skill and clean_skill not in normalized_skills:
                            normalized_skills.append(clean_skill)
                    elif isinstance(item, dict):
                        # Try to extract skills from dictionary structure
                        for key, value in item.items():
                            if 'skill' in key.lower() and isinstance(value, str):
                                skills_from_value = [s.strip().lower() for s in value.split(',')]
                                for skill in skills_from_value:
                                    if skill and skill not in normalized_skills:
                                        normalized_skills.append(skill)
                
                # If we still have no skills, try to extract from known categories
                if not normalized_skills and hasattr(self, 'text') and self.text:
                    # Extract skills from known categories using regex patterns
                    common_skills = [
                        "python", "java", "javascript", "typescript", "html", "css", "sql", "postgresql", 
                        "mongodb", "react", "angular", "vue", "node", "express", "django", "flask",
                        "aws", "azure", "gcp", "docker", "kubernetes", "devops", "ci/cd",
                        "leadership", "communication", "teamwork", "project management", "data analysis",
                        "ai", "machine learning", "deep learning", "nlp", "data science"
                    ]
                    
                    for skill in common_skills:
                        if skill.lower() in self.text.lower():
                            normalized_skills.append(skill.lower())
                
                if normalized_skills:
                    logger.info(f"Successfully extracted {len(normalized_skills)} skills with local model")
                    return normalized_skills
            
            # If we get here, extraction failed or returned no skills
            logger.warning("Local model extraction returned invalid or incomplete skills data")
        else:
            logger.info("Local model not available for skills extraction")
        
        # Fall back to the original implementation
        logger.info("Falling back to original skills extraction method")
        return original_extract_skills(self)
    except Exception as e:
        logger.error(f"Error in patched _extract_skills: {str(e)}")
        # Fall back to the original method
        return original_extract_skills(self)

def apply_patch():
    """Apply the local model patch to ResumeParser."""
    logger.info("Applying local model patch to ResumeParser")
    
    # Store the original methods for fallback
    ResumeParser._original_extract_experience_llm = ResumeParser._extract_experience_llm
    ResumeParser._original_extract_education_llm = ResumeParser._extract_education_llm
    ResumeParser._original_extract_skills = ResumeParser._extract_skills
    ResumeParser._original_extract_personal_info = ResumeParser._extract_personal_info
    
    # Check if Ollama is available
    try:
        local_model_service = get_local_model_service()
        is_available = run_async(local_model_service.is_available, timeout=3)
        logger.info(f"Local model service available: {is_available}")
        
        if is_available:
            # Apply patched methods
            ResumeParser._extract_experience_llm = _extract_experience_llm_local
            ResumeParser._extract_education_llm = _extract_education_llm_local
            ResumeParser._extract_skills = _extract_skills_local
            ResumeParser._extract_personal_info = _extract_personal_info_local
            logger.info("Local model patch successfully applied to ResumeParser")
            
            # Patch the generate_text method in LLMService to always use local model
            from backend.services.llm_service import LLMService
            original_generate_text = LLMService.generate_text
            
            async def generate_text_local_override(self, prompt, model_name=None, max_tokens=2048, temperature=0.7):
                logger.info("LLM Service generate_text redirected to local Ollama model")
                try:
                    # Always use local model
                    return await extract_with_local_model(local_model_service, prompt)
                except Exception as e:
                    logger.error(f"Error using local model, falling back to original: {str(e)}")
                    return await original_generate_text(self, prompt, model_name, max_tokens, temperature)
            
            # Apply the patch to the LLMService
            LLMService.generate_text = generate_text_local_override
            logger.info("Applied override to LLMService.generate_text to use local model")
        else:
            logger.warning("Ollama service not available - skipping local model patch")
    except Exception as e:
        logger.error(f"Error applying local model patch: {str(e)}")
        
    logger.info("Resume parsing patch configuration complete")
    
    # Create a proper synchronous wrapper that handles async functions
    original_extract_experience_llm = ResumeParser._extract_experience_llm
    
    def extract_experience_llm_wrapper(self):
        """Synchronous wrapper around experience extraction (no event loop needed)"""
        logger.info("Using local model for experience extraction - sync wrapper (no event loop)")
        try:
            return _extract_experience_llm_local(self)
        except Exception as e:
            logger.error(f"Local model experience extraction failed: {str(e)}")
            return original_extract_experience_llm(self)
    
    # Apply the synchronous wrapper override
    ResumeParser._extract_experience_llm = extract_experience_llm_wrapper
    
    # Do the same for education extraction
    original_extract_education_llm = ResumeParser._extract_education_llm
    
    def extract_education_llm_wrapper(self):
        """Synchronous wrapper around education extraction (no event loop needed)"""
        logger.info("Using local model for education extraction - sync wrapper (no event loop)")
        try:
            return _extract_education_llm_local(self)
        except Exception as e:
            logger.error(f"Local model education extraction failed: {str(e)}")
            return original_extract_education_llm(self)
    
    # Apply the synchronous wrapper override
    ResumeParser._extract_education_llm = extract_education_llm_wrapper
    logger.info("Applied final override to ensure local model use")
