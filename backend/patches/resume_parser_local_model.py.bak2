                        clean_item = {}
                        for field in ['degree', 'institution', 'location', 'date_range', 'start_date', 'end_date', 'description']:
                            clean_item[field] = normalized.get(field, "")
                        valid_items.append(clean_item)
                if valid_items:
                    logger.info(f"Successfully validated {len(valid_items)} education entries with local model (relaxed)")
                    return valid_items
                else:
                    logger.warning("No valid education entries found after normalization")
            logger.warning("Local model extraction returned invalid or incomplete education data")
        else:
            logger.info("Local model not available for education extraction")
        
        # Fall back to the original implementation
        logger.info("Falling back to original education extraction method")
