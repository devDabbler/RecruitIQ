# ==== Large model weights ====
# An 86.7 MB model.safetensors was committed once. Never again.
*.pt
*.pth
*.onnx
*.tflite
*.bin
*.safetensors
# Hugging Face / sentence-transformers cache, wherever it lands. The 86.7 MB
# blob came from one of these directories, and the cache also exists at the
# repo root - keep this rule unanchored.
sentence_transformers/

# ==== Node ====
node_modules/
.npm/
.yarn/

# ==== PII: real resumes and uploads ====
# This project ships synthetic data only. Real candidate documents must never
# be tracked. These rules are load-bearing - do not relax them.
storage/
backend/storage/
data/resumes/
data/results/
exports/
backups/
training_data/
